FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG SERVICE
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /app ./cmd/${SERVICE}

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S noteit && adduser -S -G noteit noteit
COPY --from=build /app /usr/local/bin/noteit
USER noteit
ENTRYPOINT ["/usr/local/bin/noteit"]
